rules_version = '2';
// 청첩장 참석 여부 · 방명록 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 이 내용을 그대로 붙여 넣고 '게시'하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    // 신랑·신부 관리 페이지(?admin)는 Google 로그인 없이 비밀번호 화면만 두기로 해서,
    // 참석 여부·비공개 방명록 읽기와 삭제는 규칙에서 막지 않습니다. (수정은 계속 금지)

    function validGuest() {
      return request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 12
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 200
        && request.resource.data.createdAt == request.time;
    }

    // 공개 방명록
    match /guestbook/{id} {
      allow read, delete: if true;
      allow create: if validGuest();
      allow update: if false;
    }

    // 비공개 방명록 (청첩장 화면에는 나오지 않고 관리 페이지에서만 보임)
    match /guestbook_private/{id} {
      allow read, delete: if true;
      allow create: if validGuest();
      allow update: if false;
    }

    // 참석 여부
    match /rsvp/{id} {
      allow read, delete: if true;
      allow update: if false;
      allow create: if request.resource.data.keys().hasOnly(['side', 'name', 'attend', 'count', 'meal', 'note', 'createdAt'])
        && request.resource.data.side in ['groom', 'bride']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.attend is bool
        && request.resource.data.count is int && request.resource.data.count >= 0 && request.resource.data.count <= 6
        && request.resource.data.meal in ['yes', 'no', 'unknown', '']
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.createdAt == request.time;
    }
  }
}
